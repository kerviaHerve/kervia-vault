        {
          "ruleId": "strix-coverage/admin-webui-auth-model-route-inventory",
          "ruleIndex": 5,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Admin webui auth model & route inventory — No issue identified: /admin/* and /ui/*\n\n/admin/* endpoints (agents, vaults, secrets, grants, audit, settings, templates, recovery, update, password, login/logout) all return 401 {\"error\":\"unauthorized\"} unauthenticated. Session-cookie auth via POST /admin/login {password}. Full route list from bundle recorded in note 7d5ec8."
          },
          "locations": [
            {
              "logicalLocations": [
