            }
          }
        },
        {
          "ruleId": "strix-coverage/authentication-bypass-account-state-leakage-timing",
          "ruleIndex": 6,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Authentication bypass / account-state leakage / timing — Ruled out: POST /admin/login {password}\n\nLogin requires password as a string (missing/null/number/empty → 400 invalid_request). Valid-format string → 401 {\"error\":\"invalid_credentials\"} uniformly; no account-state or format oracle (identical error for any non-matching string). Timing ~280-300ms constant across password lengths (1/16/32 chars). Failed login sets no Set-Cookie. No auth-bypass via empty/null/type-confusion/extra fields."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "POST /admin/login {password}"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Authentication bypass / account-state leakage / timing",
              "surface": "POST /admin/login {password}",
              "recorded_by": "Auth & Recovery Logic Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/session-fixation-cookie-attributes-logout",
          "ruleIndex": 7,
          "kind": "pass",
          "level": "none",
